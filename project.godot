; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VocabTest"
run/main_scene="uid://dm65j718p4jvv"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.15686275, 0.17254902, 0.20392157, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

WordManager="*uid://cbj6545unpqg6"
GameManager="*uid://dypjhihkldj5u"
RequestQueue="*uid://bvmyk0spm66yy"
ErrorManager="*uid://cfqnu5ab625w7"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="VocabTest"

[editor_plugins]

enabled=PackedStringArray("res://addons/SmoothScroll/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/uuid/plugin.cfg", "res://addons/wakatime/plugin.cfg")

[file_customization]

folder_colors={
"res://": "red",
"res://Prefabs/": "orange",
"res://Resources/": "red",
"res://Scenes/": "yellow",
"res://Scripts/": "blue"
}

[input]

fullscreen={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194342,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
